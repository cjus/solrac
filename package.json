{
  "name": "solrac",
  "version": "0.1.0",
  "description": "Self-hosted Claude-Code-style agent over Telegram (Bun runtime)",
  "license": "MIT",
  "author": "Carlos Justiniano <carlos@pnxstudios.com>",
  "homepage": "https://github.com/cjus/solrac#readme",
  "bugs": {
    "url": "https://github.com/cjus/solrac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjus/solrac.git"
  },
  "keywords": [
    "telegram",
    "claude",
    "agent",
    "bun",
    "anthropic",
    "claude-agent-sdk",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "bun test",
    "smoke:flood": "bun test/smokes/flood.ts",
    "smoke:ollama": "bun test/smokes/ollama.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@grammyjs/types": "3.26.0",
    "@types/node": "^22.0.0",
    "bun-types": "1.3.11",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.119",
    "marked": "^18.0.3"
  }
}

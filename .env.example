# Required
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
ALLOWLIST_BOOTSTRAP=123456789

# Optional (defaults shown)
SOLRAC_TRANSPORT=poll
PORT=8443
DATA_DIR=./data
HOURLY_COST_CAP_USD=1.00
GLOBAL_HOURLY_COST_CAP_USD=4.00
MAX_CONCURRENT_TURNS=4
SOLRAC_PRIMARY_MODEL=claude-sonnet-4-6    # `@` or no prefix
SOLRAC_SECONDARY_MODEL=claude-opus-4-7    # `!` prefix

# Optional (only required when used)
STATS_BEARER_TOKEN=
TG_WEBHOOK_SECRET=

# Ollama (`>` prefix routing — Step 11). Off by default.
# When OLLAMA_ENABLED=true, OLLAMA_MODEL must be set.
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
# Total turn timeout. Default is 60s when tools are off; bumps to 120s when
# OLLAMA_TOOLS_ENABLED=true (one mid-loop confirm prompt can consume 60s on
# its own, leaving zero budget for model rounds otherwise). Operator
# override here always wins.
OLLAMA_TIMEOUT_MS=60000
OLLAMA_HISTORY_LIMIT=6
# PR-A — Ollama tool-calling. When true, the `>` engine path runs through
# the multi-round tool-loop driver and exposes the same `mcp__solrac__*`
# integration tools the Claude tiers see. Requires
# SOLRAC_INTEGRATIONS_ENABLED=true (boot fails loud otherwise — there'd be
# no tools to expose). Use a tools-capable local model, e.g. gemma4:e4b
# (native function-calling, ~9.6GB, 128K context).
OLLAMA_TOOLS_ENABLED=false
# Hard ceiling on tool-loop rounds per turn. Loop detector fires earlier
# on duplicate calls; this is the runaway-loop backstop.
OLLAMA_MAX_TOOL_ITERATIONS=8

# Integrations (operator-authored TS modules + blessed built-ins). Off by
# default. When SOLRAC_INTEGRATIONS_ENABLED=true, both the blessed
# integrations bundled with solrac (`src/integrations-builtin/`) and any
# operator integrations under SOLRAC_INTEGRATIONS_DIR are loaded.
# Effective for Claude tiers (`@`, `!`) — and for the Ollama (`>`) path
# when OLLAMA_TOOLS_ENABLED=true. See docs/USAGE.md#integrations.
SOLRAC_INTEGRATIONS_ENABLED=false
SOLRAC_INTEGRATIONS_DIR=./integrations

# Web UI (browser-based interface). Off by default — Telegram-only when off.
# When SOLRAC_WEB_ENABLED=true, SOLRAC_WEB_TOKEN MUST be set (even on
# 127.0.0.1: a co-tenant on a shared host could otherwise reach the UI).
SOLRAC_WEB_ENABLED=false
# Bind address. 127.0.0.1 = loopback only. 0.0.0.0 = all interfaces
# (LAN/Tailscale/public — pair with a strong token).
SOLRAC_WEB_HOST=127.0.0.1
# Port for the web UI. Must differ from PORT (which serves /health & /stats).
SOLRAC_WEB_PORT=8080
# Login secret. Generate: openssl rand -hex 32
# Cookie set after login is HttpOnly + SameSite=Strict.
SOLRAC_WEB_TOKEN=
# Synthetic chat id all web traffic shares. Negative integer; default −1000
# avoids collision with real Telegram chat ids.
# SOLRAC_WEB_CHAT_ID=-1000

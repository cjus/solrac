# Required
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
ALLOWLIST_BOOTSTRAP=123456789

# Optional (defaults shown)
SOLRAC_TRANSPORT=poll
PORT=8443
DATA_DIR=./data
HOURLY_COST_CAP_USD=1.00
GLOBAL_HOURLY_COST_CAP_USD=4.00
MAX_CONCURRENT_TURNS=4
SOLRAC_PRIMARY_MODEL=claude-sonnet-4-6    # `@` or no prefix
SOLRAC_SECONDARY_MODEL=claude-opus-4-7    # `!` prefix

# Optional (only required when used)
STATS_BEARER_TOKEN=
TG_WEBHOOK_SECRET=

# Ollama (`>` prefix routing — Step 11). Off by default.
# When OLLAMA_ENABLED=true, OLLAMA_MODEL must be set.
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=60000
OLLAMA_HISTORY_LIMIT=6
